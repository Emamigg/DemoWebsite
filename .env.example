# Enthält den Resend-API-Key und die Empfängeradresse des Kunden.
# Diese Datei niemals weitergeben, hochladen oder committen.

# Versandart: outbox | resend | sendmail
MAIL_MODE=outbox

# API-Key von resend.com — beginnt mit re_
RESEND_KEY=

# Absenderadresse MUSS auf der eigenen Domain liegen
MAIL_FROM=Website <anfrage@example.de>

# Wohin die Benachrichtigung geht
MAIL_TO=inhaber@example.de

# Zugriffsschutz für /admin.html
ADMIN_TOKEN=demo

# Optional: SMS über eigenen Webhook
SMS_WEBHOOK=
SMS_TO=
